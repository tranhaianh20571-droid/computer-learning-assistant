# Copy to server/.env.memory, fill provider credentials locally, then --secure.
MEMORY_API_URL=http://127.0.0.1:9078
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=9078
HINDSIGHT_API_DATABASE_URL=pg0://learning-assistant-memory
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=http://127.0.0.1:18081/v1
HINDSIGHT_API_LLM_MODEL=gpt-6-luna
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_REASONING_EFFORT=low
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=Qwen/Qwen3-Embedding-8B
HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS=1024
HINDSIGHT_API_RERANKER_PROVIDER=typesafe
HINDSIGHT_API_RERANKER_TYPESAFE_BASE_URL=https://tokenflux.dev
HINDSIGHT_API_RERANKER_TYPESAFE_API_KEY=
HINDSIGHT_API_RERANKER_TYPESAFE_MODEL=jev-latest
HINDSIGHT_API_LLM_OUTPUT_LANGUAGE=Chinese
HINDSIGHT_API_ACCESS_LOG=false
HINDSIGHT_API_LOG_LEVEL=warning
HINDSIGHT_API_MCP_ENABLED=false
