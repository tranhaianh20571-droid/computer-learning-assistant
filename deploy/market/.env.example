# DuckDNS: full domain used by Caddy, e.g. studypal.duckdns.org
MARKET_DOMAIN=

# DuckDNS updater: subdomain without .duckdns.org, and token
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# Static frontend directory mounted into Caddy
MARKET_SITE_DIR=./site

# --- Market API (not part of the preview compose yet) ---
POSTGRES_DB=market
POSTGRES_USER=market
POSTGRES_PASSWORD=
MARKET_SECRET_KEY=

# --- QQ Mail ---
QQ_SMTP_HOST=smtp.qq.com
QQ_SMTP_PORT=465
QQ_SMTP_SSL=true
QQ_SMTP_TLS=false
QQ_SMTP_USER=
QQ_SMTP_PASSWORD=
QQ_FROM_EMAIL=

# --- Gmail ---
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_SSL=true
GMAIL_SMTP_TLS=false
GMAIL_SMTP_USER=
GMAIL_SMTP_PASSWORD=
GMAIL_FROM_EMAIL=
